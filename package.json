{
  "name": "@ozwild/reaper-bridge",
  "version": "0.1.0",
  "description": "A JavaScript library for controlling Reaper DAW via Web Control Surface",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./Bridge": {
      "types": "./dist/Bridge.d.ts",
      "import": "./dist/Bridge.esm.js",
      "require": "./dist/Bridge.cjs.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "reaper",
    "daw",
    "music-production",
    "audio",
    "bridge",
    "web-control-surface",
    "javascript",
    "typescript"
  ],
  "author": "Ozwild",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozwild/reaper-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/ozwild/reaper-bridge/issues"
  },
  "homepage": "https://github.com/ozwild/reaper-bridge#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.5",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "rollup": "^4.7.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  },
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{js,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx}\"",
    "prepublishOnly": "npm run type-check && npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
